{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ app.request.getSchemeAndHttpHost() }}/modules/mzcproductfields/views/js/admin-field-form.js?v=2.3.0"></script>
{% endblock %}

{% block content %}
  <div class="panel">
    <div class="panel-heading">
      {{ 'Product personalization fields'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      <a href="{{ path('mzc_productfields_field_create') }}" class="btn btn-primary pull-right">
        {{ 'Add new field'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </a>
      <a href="{{ path('mzc_productfields_font_index') }}" class="btn btn-default pull-right" style="margin-right:8px;">
        {{ 'Manage fonts'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </a>
      <a href="{{ path('mzc_productfields_background_index') }}" class="btn btn-default pull-right" style="margin-right:8px;">
        {{ 'Manage backgrounds'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </a>
      <a href="{{ path('mzc_productfields_background_rule_index') }}" class="btn btn-default pull-right" style="margin-right:8px;">
        {{ 'Background per combination'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </a>
      <a href="{{ path('mzc_productfields_migrator_index') }}" class="btn btn-default pull-right" style="margin-right:8px;">
        {{ 'Migrate from Anvanto'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </a>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>{{ 'ID'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th>{{ 'Label'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th>{{ 'Type'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th>{{ 'Scope'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th>{{ 'Paid'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th>{{ 'Active'|trans({}, 'Modules.Mzcproductfields.Admin') }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for field in fields %}
          <tr>
            <td>{{ field.id_mzc_productfields_field }}</td>
            <td>{{ field.label }}</td>
            <td>{{ field.field_type }}</td>
            <td>
              {% if field.scope_type == 0 %}{{ 'All products'|trans({}, 'Modules.Mzcproductfields.Admin') }}
              {% elseif field.scope_type == 1 %}{{ 'Category'|trans({}, 'Modules.Mzcproductfields.Admin') }} #{{ field.scope_id }}
              {% else %}{{ '%count% product(s)'|trans({'%count%': field.product_count}, 'Modules.Mzcproductfields.Admin') }}
              {% endif %}
            </td>
            <td>{{ field.is_paid ? 'Yes'|trans({}, 'Modules.Mzcproductfields.Admin') : 'No'|trans({}, 'Modules.Mzcproductfields.Admin') }}</td>
            <td>{{ field.active ? 'Yes'|trans({}, 'Modules.Mzcproductfields.Admin') : 'No'|trans({}, 'Modules.Mzcproductfields.Admin') }}</td>
            <td>
              <a href="{{ path('mzc_productfields_field_edit', {id: field.id_mzc_productfields_field}) }}">
                {{ 'Edit'|trans({}, 'Modules.Mzcproductfields.Admin') }}
              </a>
              <form method="post" action="{{ path('mzc_productfields_field_delete', {id: field.id_mzc_productfields_field}) }}" style="display:inline" onsubmit="return confirm('{{ 'Delete this field?'|trans({}, 'Modules.Mzcproductfields.Admin') }}');">
                <button type="submit" class="btn btn-link">{{ 'Delete'|trans({}, 'Modules.Mzcproductfields.Admin') }}</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7">{{ 'No fields yet.'|trans({}, 'Modules.Mzcproductfields.Admin') }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if showcase.limit > 0 %}
    <div class="panel">
      <div class="panel-heading">
        {{ 'Home page: live personalization section'|trans({}, 'Modules.Mzcproductfields.Admin') }}
      </div>
      <form method="post" action="{{ path('mzc_productfields_showcase_save') }}">
        <input type="hidden" name="showcase_products" id="mzc_showcase_products" value="[]">

        <div class="js-mzc-showcase-products" data-mzc-search-url="{{ showcase.search_url }}" data-mzc-max="{{ showcase.limit }}">
          <p class="text-muted">
            {{ 'Products offered in the "live personalization" section of the home page, in this order — the first one is shown before a visitor clicks anything. Only products with a text field for the front, an active status and a photo can appear.'|trans({}, 'Modules.Mzcproductfields.Admin') }}
          </p>
          <input type="text" class="form-control js-mzc-search-input" autocomplete="off"
                 placeholder="{{ 'Search product (name, reference or ID)'|trans({}, 'Modules.Mzcproductfields.Admin') }}">
          <ul class="js-mzc-suggestions list-group" style="display:none; position:absolute; z-index:1000; max-width:400px;"></ul>
          <div class="js-mzc-selected" style="margin-top:8px;"
               data-initial="{{ showcase.entries|json_encode }}"></div>
          <small class="form-text text-muted">
            <span class="js-mzc-count"></span>
            {{ 'Leave empty to choose automatically from the Home category.'|trans({}, 'Modules.Mzcproductfields.Admin') }}
          </small>
        </div>

        <div style="margin-top:12px;">
          <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Mzcproductfields.Admin') }}</button>
        </div>
      </form>
    </div>
  {% endif %}
{% endblock %}
