{
  "name": "mzc/brevo",
  "description": "Contacts, orders and cart events to Brevo API v3, server-side through a queue. Replaces the official Brevo plugin.",
  "version": "1.0.0",
  "type": "prestashop-module",
  "license": "MIT",
  "authors": [
    {
      "name": "Marcin Zbijowski Consulting",
      "homepage": "https://zbijowski.consulting"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/http-client": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "Mzc\\Brevo\\": "src/"
    },
    "classmap": [
      "mzcbrevo.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Mzc\\Brevo\\Tests\\": "tests/Unit/"
    }
  },
  "config": {
    "prepend-autoloader": false,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
